<header class="site-header">
  <div class="header__inner">

    {%- comment -%} Brand / Logo {%- endcomment -%}
    <div class="header__brand">
      <h2 class="header__title">
        {{ shop.name | link_to: routes.root_url }}
      </h2>
    </div>

    {%- comment -%} Primary Navigation {%- endcomment -%}
    <nav class="header__nav" aria-label="Primary navigation">
      {% for link in section.settings.menu.links %}
        <a class="header__nav-link" href="{{ link.url }}">
          {{ link.title }}
        </a>
      {% endfor %}
    </nav>

    {%- comment -%} Action Icons {%- endcomment -%}
    <div class="header__actions">
      {% if shop.customer_accounts_enabled %}
        <shopify-account
          class="header__icon-btn"
          menu="{{ section.settings.customer_account_menu }}"
          aria-label="Account"
        >
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      <a class="header__icon-btn header__cart-btn" href="{{ routes.cart_url }}" aria-label="Cart">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}
          <span class="header__cart-badge">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>

  </div>
</header>

{% stylesheet %}
  /* ── Header Shell ─────────────────────────────────────── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;

    /* Glassmorphism */
    background: rgba(var(--header-bg-rgb, 255 255 255), 0.72);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);

    /* Refined border */
    border-bottom: 1px solid rgba(var(--header-border-rgb, 0 0 0), 0.08);

    /* Subtle accent line at very top */
    box-shadow:
      0 1px 0 0 rgba(var(--header-border-rgb, 0 0 0), 0.06),
      0 4px 24px -8px rgba(var(--header-border-rgb, 0 0 0), 0.12);

    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  /* Premium gradient accent line */
  .site-header::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(99, 102, 241, 0.8) 20%,
      rgba(168, 85, 247, 0.9) 50%,
      rgba(236, 72, 153, 0.8) 80%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* ── Inner Container ──────────────────────────────────── */
  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 4.5rem;
    max-width: var(--page-width, 1280px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 1.5rem);
    gap: 1.5rem;
  }

  /* ── Brand ────────────────────────────────────────────── */
  .header__brand {
    display: flex;
    align-items: center;
  }

  .header__title {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .header__title a {
    text-decoration: none;
    color: var(--color-foreground);
    background: linear-gradient(
      135deg,
      var(--color-foreground) 0%,
      rgba(99, 102, 241, 1) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    transition: opacity 0.2s ease;
  }

  .header__title a:hover {
    opacity: 0.8;
  }

  /* ── Navigation ───────────────────────────────────────── */
  .header__nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    justify-content: center;
  }

  .header__nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.85rem;
    text-decoration: none;
    color: var(--color-foreground);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    border-radius: 0.5rem;
    transition:
      color 0.2s ease,
      background 0.2s ease;
    white-space: nowrap;
  }

  /* Animated underline */
  .header__nav-link::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    transform-origin: center;
    width: calc(100% - 1.7rem);
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, rgb(99, 102, 241), rgb(168, 85, 247));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .header__nav-link:hover {
    color: rgb(99, 102, 241);
    background: rgba(99, 102, 241, 0.06);
  }

  .header__nav-link:hover::after {
    transform: translateX(-50%) scaleX(1);
  }

  /* Active state */
  .header__nav-link[aria-current="page"] {
    color: rgb(99, 102, 241);
    background: rgba(99, 102, 241, 0.08);
  }

  .header__nav-link[aria-current="page"]::after {
    transform: translateX(-50%) scaleX(1);
  }

  /* ── Actions ──────────────────────────────────────────── */
  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: flex-end;
  }

  .header__icon-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.625rem;
    color: var(--color-foreground);
    text-decoration: none;
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .header__icon-btn:hover {
    background: rgba(99, 102, 241, 0.08);
    color: rgb(99, 102, 241);
    transform: translateY(-1px);
  }

  .header__icon-btn:active {
    transform: translateY(0) scale(0.96);
  }

  .header__icon-btn svg {
    width: 1.35rem;
    height: 1.35rem;
    pointer-events: none;
  }

  /* ── Cart Badge ───────────────────────────────────────── */
  .header__cart-badge {
    position: absolute;
    top: 0.1rem;
    right: 0.1rem;
    min-width: 1.1rem;
    height: 1.1rem;
    padding: 0 0.2rem;
    border-radius: 99px;
    background: linear-gradient(135deg, rgb(99, 102, 241), rgb(168, 85, 247));
    color: #fff;
    font-size: 0.6rem;
    font-weight: 700;
    line-height: 1.1rem;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: badge-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    pointer-events: none;
  }

  @keyframes badge-pop {
    from { transform: scale(0); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
  }

  /* ── Responsive: hide nav on small screens ────────────── */
  @media (max-width: 768px) {
    .header__inner {
      grid-template-columns: 1fr auto;
    }

    .header__nav {
      display: none;
    }

    .header__actions {
      grid-column: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
